# Mixamo assets — Adobe's terms forbid redistribution. Download Y Bot
# yourself and build the scene with pipeline/setup_rig.py (docs/INSTALL.md).
ybot.fbx
*.fbx
*_rest.blend
*.blend1
rig_profile.json

# The author's plates and produced clips are demonstration material,
# not part of the distributed pipeline. They stay local.
plates/
clips/

# Local reference material not meant to ship (rig measurement dumps etc.)
local/

# External tools: GVHMR checkout, its venv, checkpoints and the
# license-gated SMPL-X body model all live here. Never commit them.
tools/

# Local notes (session ids, scratch notes) — never published.
*.txt

# Python
__pycache__/
*.pyc

# Per-character rig measurements (setup_rig.py / setup_duo.py). Derived
# from your own Mixamo downloads, same as rig_profile.json above.
rig_profiles/

# --- Local additions (Mocap UI, GLB characters, FBX export) ---
# License-gated or personal assets: the SMPL-X archive must never be
# redistributed; characters are your own downloads/creations.
*.zip
*.glb
*.gltf
*.blend
# Specs the UI / mocap.py writes for your own videos; only the examples ship.
action_specs/*.json
!action_specs/combo.json
!action_specs/duel_ninja.json
!action_specs/duel_ybot.json
!action_specs/fight.json
!action_specs/kungfu_form.json
!action_specs/spin.json
!action_specs/tennis.json
